# Copy to .env.local for local development
# VITE_* vars are embedded at build time by Vite — never put secrets here

# Google Places Autocomplete API key
# Restrict this key to HTTP referrers (your domain) in Google Cloud Console
VITE_GOOGLE_PLACES_KEY=your_google_places_api_key_here

# URL of your deployed Cloudflare Worker (or http://localhost:8787 for local dev)
VITE_ENRICH_API_URL=http://localhost:8787
